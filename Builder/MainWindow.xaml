<Window x:Class="Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aesthetic Builder" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <!-- Анимация для будущего использования -->
    </Window.Resources>
    
    <Border CornerRadius="15" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#30FFD700" Offset="0"/>
                <GradientStop Color="#20FFA500" Offset="0.5"/>
                <GradientStop Color="#30FFD700" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <SolidColorBrush Color="#FFFFFF"/>
        </Border.Background>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок внизу первой строки -->
            <Grid Grid.Row="0" Margin="30,0,30,0" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" 
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,0">
                    <Border Width="45" Height="45" 
                            CornerRadius="12"
                            Margin="0,0,15,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFD700" Offset="0"/>
                                <GradientStop Color="#FFA500" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" 
                                  FontSize="24" 
                                  Foreground="Black" 
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontWeight="Bold"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Aesthetic Builder" 
                                  FontSize="24" 
                                  FontWeight="Bold"
                                  Foreground="#2C2C2C"/>
                        <TextBlock Text="by Arsentiy" 
                                  FontSize="11" 
                                  Foreground="#808080" 
                                  Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Кнопки управления окном на одной линии с заголовком -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,0">
                    <!-- Кнопки управления окном -->
                    <Button Content="─" 
                           Width="40" Height="40"
                           Style="{StaticResource WindowButton}"
                           Click="MinimizeButton_Click"/>
                    <Button Content="✕" 
                           Width="40" Height="40"
                           Style="{StaticResource WindowButton}"
                           Click="CloseButton_Click"
                           Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
            
            <!-- Вкладки на одной линии с заголовком -->
            <StackPanel Grid.Row="0"
                       Orientation="Horizontal" 
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,130,0">
                <!-- Вкладки квадратами -->
                <Button x:Name="TabSend" 
                       Style="{StaticResource TabIconActive}"
                       Click="TabSend_Click"
                       ToolTip="Send">
                    <Image Source="inbox(1).png" Width="20" Height="20"/>
                </Button>
                <Button x:Name="TabSettings" 
                       Style="{StaticResource TabIcon}"
                       Click="TabSettings_Click"
                       ToolTip="Settings"
                       Margin="8,0,0,0">
                    <Image Source="cogwheel.png" Width="20" Height="20"/>
                </Button>
                <Button x:Name="TabBuild" 
                       Style="{StaticResource TabIcon}"
                       Click="TabBuild_Click"
                       ToolTip="Build"
                       Margin="8,0,0,0">
                    <Image Source="crossed-hammers.png" Width="20" Height="20"/>
                </Button>
            </StackPanel>
            
            <!-- Контент вкладок -->
            <Grid Grid.Row="1" Margin="20,20,20,20">
                <!-- Send Tab -->
                <Border x:Name="SendTab" 
                        CornerRadius="12"
                        BorderThickness="1"
                        Visibility="Visible">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F8F8F8" Offset="0"/>
                            <GradientStop Color="#F0F0F0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E0E0E0" Offset="0"/>
                            <GradientStop Color="#D0D0D0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40">
                        <StackPanel MaxWidth="500">
                            <TextBlock Text="Delivery Method" 
                                      FontSize="20" 
                                      FontWeight="Bold"
                                      Foreground="#2C2C2C"
                                      Margin="0,0,0,25"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,35">
                                <RadioButton x:Name="RadioTelegram"
                                           Content="Telegram" 
                                           IsChecked="True"
                                           Style="{StaticResource RadioButtonStyle}"
                                           Checked="RadioTelegram_Checked"/>
                                <RadioButton x:Name="RadioPanel"
                                           Content="Web Panel" 
                                           Style="{StaticResource RadioButtonStyle}"
                                           Checked="RadioPanel_Checked"/>
                                <RadioButton x:Name="RadioDiscord"
                                           Content="Discord" 
                                           Style="{StaticResource RadioButtonStyle}"
                                           Checked="RadioDiscord_Checked"/>
                            </StackPanel>
                            
                            <!-- Telegram Settings -->
                            <StackPanel x:Name="TelegramPanel" Visibility="Visible">
                                <TextBlock Text="Bot Token" 
                                          FontSize="13" 
                                          Foreground="#606060" 
                                          Margin="0,0,0,12"/>
                                <Border Style="{StaticResource GlassInput}">
                                    <TextBox x:Name="TxtBotToken"
                                            Style="{StaticResource DarkTextBox}"
                                            Text=""/>
                                </Border>
                                
                                <TextBlock Text="Chat ID" 
                                          FontSize="13" 
                                          Foreground="#606060" 
                                          Margin="0,30,0,12"/>
                                <Border Style="{StaticResource GlassInput}">
                                    <TextBox x:Name="TxtChatId"
                                            Style="{StaticResource DarkTextBox}"
                                            Text=""/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Web Panel Settings -->
                            <StackPanel x:Name="PanelPanel" Visibility="Collapsed">
                                <TextBlock Text="Panel URL" 
                                           FontSize="13" 
                                           Foreground="#606060" 
                                           Margin="0,0,0,12"/>
                                <Border Style="{StaticResource GlassInput}">
                                    <TextBox x:Name="TxtPanelUrl"
                                            Style="{StaticResource DarkTextBox}"
                                            Text="http://localhost:3000/api/upload"/>
                                </Border>
                                
                                <TextBlock Text="Secret Key" 
                                           FontSize="13" 
                                           Foreground="#606060" 
                                           Margin="0,30,0,12"/>
                                <Border Style="{StaticResource GlassInput}">
                                    <TextBox x:Name="TxtSecretKey"
                                            Style="{StaticResource DarkTextBox}"
                                            Text="aesthetic_secret_key_123"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Discord Settings -->
                            <StackPanel x:Name="DiscordPanel" Visibility="Collapsed">
                                <TextBlock Text="Webhook URL" 
                                          FontSize="13" 
                                          Foreground="#606060" 
                                          Margin="0,0,0,12"/>
                                <Border Style="{StaticResource GlassInput}">
                                    <TextBox x:Name="TxtWebhook"
                                            Style="{StaticResource DarkTextBox}"/>
                                </Border>
                                
                                <Border CornerRadius="10"
                                        BorderThickness="1"
                                        Padding="20"
                                        Margin="0,25,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#15FFD700" Offset="0"/>
                                            <GradientStop Color="#08FFA500" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#30FFD700" Offset="0"/>
                                            <GradientStop Color="#15FFA500" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <TextBlock Text="🚧 Coming soon..." 
                                              FontSize="14" 
                                              FontWeight="SemiBold"
                                              Foreground="#FFD700"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- Settings Tab -->
                <Border x:Name="SettingsTab" 
                        CornerRadius="12"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F8F8F8" Offset="0"/>
                            <GradientStop Color="#F0F0F0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E0E0E0" Offset="0"/>
                            <GradientStop Color="#D0D0D0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40">
                        <StackPanel MaxWidth="500">
                            <TextBlock Text="Build Settings" 
                                      FontSize="20" 
                                      FontWeight="Bold"
                                      Foreground="#2C2C2C"
                                      Margin="0,0,0,25"/>
                            
                            <Border CornerRadius="10"
                                    BorderThickness="1"
                                    Padding="20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#15FFD700" Offset="0"/>
                                        <GradientStop Color="#08FFA500" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#30FFD700" Offset="0"/>
                                        <GradientStop Color="#15FFA500" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <TextBlock Text="🚧 Coming soon..." 
                                          FontSize="14" 
                                          FontWeight="SemiBold"
                                          Foreground="#FFD700"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- Build Tab -->
                <Border x:Name="BuildTab" 
                        CornerRadius="12"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F8F8F8" Offset="0"/>
                            <GradientStop Color="#F0F0F0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E0E0E0" Offset="0"/>
                            <GradientStop Color="#D0D0D0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid Margin="40">
                        <StackPanel MaxWidth="700" VerticalAlignment="Top">
                            <Grid Margin="0,0,0,30">
                                <TextBlock Text="Build Output" 
                                          FontSize="20" 
                                          FontWeight="Bold"
                                          Foreground="#2C2C2C"
                                          VerticalAlignment="Center"/>
                                
                                <Button Content="🔨 BUILD" 
                                       Style="{StaticResource PrimaryButton}"
                                       HorizontalAlignment="Right"
                                       Click="BuildButton_Click"/>
                            </Grid>
                            
                            <Border CornerRadius="12"
                                   BorderThickness="1"
                                   MinHeight="420">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FAFAFA" Offset="0"/>
                                        <GradientStop Color="#F5F5F5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E0E0E0" Offset="0"/>
                                        <GradientStop Color="#D0D0D0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                             Padding="25">
                                    <TextBlock x:Name="TxtBuildLog"
                                              Text="Ready to build..."
                                              FontFamily="Consolas"
                                              FontSize="13"
                                              Foreground="#606060"
                                              TextWrapping="Wrap"
                                              LineHeight="20"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
